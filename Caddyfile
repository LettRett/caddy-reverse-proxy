# global options
{
	admin off
	persist_config off
	auto_https off

	# Ensure geo vars are set before we use them anywhere
	order geoip2_vars first
	order rate_limit before reverse_proxy

	log {
		format json
	}

	servers {
		# ✅ Trust only private proxy hops (typical for Railway -> container networking)
		# This prevents spoofing X-Forwarded-For from the public internet.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}

	geoip2 {
		databaseDirectory "/usr/share/GeoIP/"
		editionID "GeoLite2-Country"
	}
}

(lb_settings) {
	lb_policy round_robin
	lb_retries 100
	lb_try_duration 10s
	lb_try_interval 250ms
}

(passive_health_checks) {
	fail_duration 60s
	max_fails 300
	unhealthy_latency 5s
	unhealthy_request_count 200
}

(security_headers) {
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(rate_limiting) {
	rate_limit {
		zone general {
			key {client_ip}
			events 200
			window 1m
		}

		zone api {
			match {
				path /api/*
			}
			key {client_ip}
			events 100
			window 1m
		}

		zone auth {
			match {
				path /oauth2/* /login/*
			}
			key {client_ip}
			events 10
			window 1m
		}

		zone login_strict {
			match {
				path /oauth2/authorization/* /login/oauth2/code/*
			}
			key {client_ip}
			events 5
			window 5m
		}

		log_key
		jitter 0.2
	}
}

:{$PORT} {
	log {
		format json
	}

	# Must be first inside the site: sets geoip2.* based on {client_ip} (trusted proxies)
	geoip2_vars trusted_proxies

	import security_headers

	# Debug endpoint (kept)
	@debug path /debug/ip
	handle @debug {
		respond "Remote IP: {remote_host}
Client IP: {client_ip}
X-Forwarded-For: {header.X-Forwarded-For}
X-Real-IP: {header.X-Real-IP}
GeoIP Country: {geoip2.country_code}
GeoIP Country Name: {geoip2.country_name}"
	}

	# ✅ Geo allowlist: Scandinavia + Nordics (NO, SE, DK, FI, IS)
	# Block everything else (but allow private ranges for internal calls / local testing)
	@blocked_geo {
		not expression `{geoip2.country_code} in ["NO","SE","DK","FI","IS"]`
		not remote_ip private_ranges
	}
	respond @blocked_geo "Access denied - this service is only available in Scandinavia (detected: {geoip2.country_code})" 403

	# ✅ Rate limit after geo-block (so blocked traffic doesn’t waste limiter capacity)
	import rate_limiting

	# --- Routes to backends ---

	handle /oauth2/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}
			import lb_settings
			import passive_health_checks

			# Usually you want the original Host preserved for apps behind the proxy:
			# header_up Host {host}
			# If your upstream truly needs upstream_hostport, keep your old line instead.
			header_up Host {host}
		}
	}

	handle /login/oauth2/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}
			import lb_settings
			import passive_health_checks
			header_up Host {host}
		}
	}

	handle_path /api/* {
		reverse_proxy {
			dynamic a {
				name {$BACKEND_DOMAIN}
				port {$BACKEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}
			import lb_settings
			import passive_health_checks
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy {
			dynamic a {
				name {$FRONTEND_DOMAIN}
				port {$FRONTEND_PORT}
				refresh 1s
				dial_timeout 30s
				versions ipv4 ipv6
			}
			import lb_settings
			import passive_health_checks
			header_up Host {host}
		}
	}
}
